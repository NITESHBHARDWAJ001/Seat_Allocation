{
  "name": "exam-room-allocator",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=apps/backend",
    "test": "npm run test --workspace=packages/allocation-engine",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "seed": "node scripts/generate-fixtures.mjs",
    "seed:excel": "tsx scripts/generate-excel-templates.mts && tsx scripts/generate-excel-test-files.mts",
    "sync:backend-vendor": "node scripts/sync-backend-vendor.mjs",
    "sync:frontend-vendor": "node scripts/sync-frontend-vendor.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
