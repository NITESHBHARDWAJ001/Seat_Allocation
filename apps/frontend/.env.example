# Copy to apps/frontend/.env for local development (on a hosted frontend, set the same variable in its dashboard).
#
# The backend address. The app never asks users for it - there is no server field in the UI.
#  - Set: the app starts in SERVER mode (public landing page, sign-in, registration, background sync).
#  - Unset: "npm run dev" falls back to http://localhost:4000; a production build shows "server address is not
#    configured" on the sign-in screen. (Local-only guest mode is still available from the landing page.)
#
# Only variables prefixed VITE_ reach the browser bundle - never put a secret here. The database password lives ONLY
# in the backend's environment.
#
# Local backend:      VITE_API_BASE_URL=http://localhost:4000
# Deployed backend:   VITE_API_BASE_URL=https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:4000
