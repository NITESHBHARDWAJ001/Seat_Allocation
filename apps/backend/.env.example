# Copy this file to .env for local dev, or set these as real environment
# variables in your hosting platform's dashboard (Render, Railway, Fly.io,
# a VPS, etc). Never commit a real .env file.

# Port the Express API listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your deployed
# frontend's URL, plus http://localhost:5173 for local dev). Leave unset to
# allow any origin (fine for local dev, NOT recommended in production).
CORS_ORIGIN=http://localhost:5173

# Which repository implementation the API runs on. Both implement the exact
# same interfaces from packages/core, so nothing else in the app changes.
#   json   (default) JSON files on local disk - see DATA_DIR below.
#   sheets a Google Sheet, via a service account - see the GOOGLE_* vars below.
DATA_BACKEND=json

# --- json backend ---
# Where the JSON-file data store writes its files. Defaults to ./data next to
# this app if unset. IMPORTANT: most serverless/managed hosts (Vercel
# functions, most free-tier containers) have an EPHEMERAL filesystem - files
# written here vanish on redeploy/restart. If you host this for real, either
# point DATA_DIR at a mounted persistent volume, or use the sheets backend,
# or swap in a real database (same repository-interface pattern).
# DATA_DIR=/data

# --- sheets backend (only needed when DATA_BACKEND=sheets) ---
# The spreadsheet's id - the long string in its URL between /d/ and /edit.
# GOOGLE_SHEETS_ID=

# A Google Cloud service account with the Sheets API enabled. Share the
# target spreadsheet with this account's email as an Editor, or every call
# will fail with a permission error.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The service account's private key, exactly as it appears in the downloaded
# JSON key file's "private_key" field (including the literal \n sequences
# and the BEGIN/END PRIVATE KEY lines), wrapped in double quotes.
# NEVER commit a real value for this - treat it like a password. If one is
# ever pasted somewhere it could be logged or seen by others (a chat, a
# support ticket, a public repo), rotate it in Google Cloud Console
# immediately, even if you also removed it from that place afterward.
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
